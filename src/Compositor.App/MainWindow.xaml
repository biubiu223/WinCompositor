<Window x:Class="Compositor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:Compositor.App.Drawing"
        xmlns:panels="clr-namespace:Compositor.App.Panels"
        Style="{StaticResource DarkWindow}"
        Title="WinCompositor" Width="1320" Height="860" MinWidth="820" MinHeight="540"
        Icon="Assets/Compositor.ico" AllowDrop="True">
    <DockPanel x:Name="Root">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="4,2" />

        <!-- New canvas, project tabs, zoom controls -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Height="38">
            <DockPanel Margin="8,0">
                <Button x:Name="NewButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Width="30" Height="28" Margin="0,0,6,0" />
                <StackPanel x:Name="ZoomButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The active tool's options -->
        <Border x:Name="OptionsBar" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MinHeight="40">
            <ContentControl x:Name="OptionsHost" Margin="14,0" VerticalAlignment="Center" />
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="StatusZoom" Style="{StaticResource DimText}" Width="64" FontSize="11" />
                <TextBlock x:Name="StatusSize" Style="{StaticResource DimText}" Margin="0,0,16,0" FontSize="11" />
                <TextBlock x:Name="StatusColor" Style="{StaticResource DimText}" Margin="0,0,16,0" FontSize="11" />
                <TextBlock x:Name="StatusHint" Style="{StaticResource DimText}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="11" />
            </DockPanel>
        </Border>

        <Grid x:Name="Workspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolColumn" Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition x:Name="PanelColumn" Width="260" MinWidth="200" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Tool rail -->
            <Border x:Name="ToolRail" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="ToolStack" Margin="0,12,0,12" HorizontalAlignment="Center" />
                </ScrollViewer>
            </Border>

            <!-- Canvas with rulers -->
            <Grid x:Name="CanvasArea" Grid.Column="1" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RulerRow" Height="0" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RulerColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#FF262626" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" />
                <ContentControl x:Name="HorizontalRulerHost" Grid.Row="0" Grid.Column="1" />
                <ContentControl x:Name="VerticalRulerHost" Grid.Row="1" Grid.Column="0" />
                <canvas:CanvasView x:Name="Canvas" Grid.Row="1" Grid.Column="1" />
                <Canvas x:Name="TextInputHost" Grid.Row="1" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True" />
                <canvas:NavigatorMinimap x:Name="Navigator" Grid.Row="1" Grid.Column="1" />
                <ContentControl x:Name="WelcomeHost" Grid.Row="1" Grid.Column="1" />
                <Border x:Name="MaskBadge" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                        Background="#E6303030" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="MaskBadgeText" FontSize="11" />
                </Border>
                <Border x:Name="DropHighlight" Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" CornerRadius="8" Margin="3"
                        Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext" Focusable="False" />

            <panels:LayersPanel x:Name="LayersPanel" Grid.Column="3" />
        </Grid>
    </DockPanel>
</Window>
