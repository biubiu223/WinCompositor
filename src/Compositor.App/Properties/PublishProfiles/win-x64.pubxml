<?xml version="1.0" encoding="utf-8"?>
<!-- The release build people download: one WinCompositor.exe with the .NET 8 runtime (WPF included) inside, so it runs on
     a Windows 10/11 machine with nothing installed. The AI models stay in the Models folder beside it.
     dotnet publish src/Compositor.App -c Release -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's and SkiaSharp's native libraries go inside the one file too (unpacked to a temp folder on first start). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The bundled runtime compressed: a much smaller download for a moment more at start-up. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No debug symbols in the download. -->
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\WinCompositor\</PublishDir>
  </PropertyGroup>

  <!-- Symbols that would still come along — Compositor.Core's, and the 80 MB one SkiaSharp's native package ships. -->
  <Target Name="LeaveSymbolsOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
